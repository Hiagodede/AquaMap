<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only. iOS/Mac Catalyst/Windows were removed in v2 (see docs/PLANO_V2.md) -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<MauiVersion>10.0.110</MauiVersion>

		<UseMaui>true</UseMaui>
		<!-- Only Microsoft.Maui.Essentials (DeviceInfo) is needed here, not Controls/XAML -->
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>AquaMap.Client.Shared</RootNamespace>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AquaMap.Domain\AquaMap.Domain.csproj" />
	</ItemGroup>

</Project>
